# Copy to .env and restart `npm run dev`.

# mock = built-in sample data (default). live = every operation goes to your API.
VITE_API_MODE=mock

# Your API root. Paths come from src/api/contract.js.
VITE_API_BASE_URL=https://api.example.com/v1

# Only in mock mode: go live one module at a time, e.g. auth,market,orders
VITE_API_LIVE_OPS=

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=20000

# off = your API returns the bare payload instead of { "data": ... }
VITE_API_ENVELOPE=on

# Optional WebSocket for live prices
VITE_API_WS_URL=
